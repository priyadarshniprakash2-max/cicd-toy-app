FROM node:20-trixie-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/*

COPY package*.json ./

RUN npm ci --omit=dev && npm install --no-save tar@7.5.19 && npm cache clean --force

COPY . .

FROM node:20-trixie-slim

WORKDIR /app

RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* && groupadd --system appgroup && useradd --system --gid appgroup --home-dir /tmp appuser

ENV HOME=/tmp

COPY --from=builder --chown=appuser:appgroup /app /app

USER appuser

EXPOSE 3001 3002 3003

CMD ["node", "server.js"]
